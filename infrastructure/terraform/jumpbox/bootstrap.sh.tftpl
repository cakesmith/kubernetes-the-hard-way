#!/bin/bash
set -euo pipefail

# Install SSM first so the operator can inspect or retry later setup over SSH.
export DEBIAN_FRONTEND=noninteractive
apt-get -o Acquire::Retries=5 update
if ! dpkg-query -W -f='$${db:Status-Status}' amazon-ssm-agent 2>/dev/null | grep -qx installed; then
  apt-get -o Acquire::Retries=5 install -y ca-certificates curl
  agent_dir=$(mktemp -d)
  trap 'rm -rf "$agent_dir"' EXIT
  curl --fail --silent --show-error --retry 5 --location \
    https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/debian_amd64/amazon-ssm-agent.deb \
    --output "$agent_dir/amazon-ssm-agent.deb"
  dpkg -i "$agent_dir/amazon-ssm-agent.deb"
fi
systemctl enable --now amazon-ssm-agent

apt-get -o Acquire::Retries=5 install -y nftables haproxy openssl

cat > /etc/sysctl.d/90-kthw-router.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
net.ipv4.conf.*.send_redirects = 0
SYSCTL

# Replace only the lab table, atomically. The same ENI receives and sends NAT traffic.
cat > /etc/nftables.conf <<'NFT'
#!/usr/sbin/nft -f
table ip kthw
delete table ip kthw
table ip kthw {
  set clients {
    type ipv4_addr
    flags interval
    elements = { ${nat_sources} }
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    ip daddr { ${vpc_cidr}, ${pod_cidrs}, 169.254.0.0/16 } drop
    ip saddr @clients tcp dport { 80, 443 } accept
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip daddr { ${vpc_cidr}, ${pod_cidrs}, 169.254.0.0/16 } return
    ip saddr @clients tcp dport { 80, 443 } masquerade
  }
}
NFT

nft -c -f /etc/nftables.conf
systemctl enable nftables
# Reload directly so Debian's service stop action cannot flush unrelated tables.
nft -f /etc/nftables.conf
systemctl start nftables
systemctl restart systemd-sysctl

install -d -m 0700 /etc/haproxy/tls
pem=/etc/haproxy/tls/jumpbox.pem
if [[ ! -s "$pem" ]]; then
  cert_dir=$(mktemp -d /etc/haproxy/tls/.cert.XXXXXX)
  trap 'rm -rf "$${agent_dir:-}" "$cert_dir"' EXIT
  openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 365 \
    -subj /CN=kthw-ingress.local -addext subjectAltName=DNS:kthw-ingress.local \
    -keyout "$cert_dir/key" -out "$cert_dir/cert"
  umask 077
  cat "$cert_dir/cert" "$cert_dir/key" > "$cert_dir/bundle"
  mv "$cert_dir/bundle" "$pem"
fi

config=$(mktemp /etc/haproxy/.kthw.XXXXXX)
cat > "$config" <<'HAPROXY'
global
    user haproxy
    group haproxy

defaults
    mode http
    timeout connect 3s
    timeout client 30s
    timeout server 30s

frontend web
    bind :80
    bind :443 ssl crt /etc/haproxy/tls/jumpbox.pem ssl-min-ver TLSv1.2
    http-request set-header X-Forwarded-For %[src]
    http-request set-header X-Forwarded-Proto http
    http-request set-header X-Forwarded-Proto https if { ssl_fc }
    default_backend kubernetes

backend kubernetes
    balance roundrobin
    server node-0 ${worker_0}:${nodeport} check
    server node-1 ${worker_1}:${nodeport} check
HAPROXY

haproxy -c -f "$config"
mv "$config" /etc/haproxy/haproxy.cfg
systemctl enable --now haproxy
systemctl reload haproxy
